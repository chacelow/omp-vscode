{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (omp-vscode)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/omp-vscode"
      ],
      "outFiles": ["${workspaceFolder}/packages/omp-vscode/dist/**/*.js"],
      "preLaunchTask": "pnpm: build"
    }
  ]
}
