{
  "name": "omp-vscode",
  "displayName": "OMP Chat",
  "description": "Oh My Pi coding agent inside VS Code. Native webview chat driven by the omp-web local service (HTTP + SSE), zero server changes.",
  "version": "0.1.0",
  "publisher": "omp",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "omp.openChat",
        "title": "Open Chat",
        "category": "OMP"
      },
      {
        "command": "omp.startServer",
        "title": "Start Server",
        "category": "OMP"
      },
      {
        "command": "omp.stopServer",
        "title": "Stop Server",
        "category": "OMP"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omp",
          "title": "OMP",
          "icon": "media/omp.svg"
        }
      ]
    },
    "views": {
      "omp": [
        {
          "id": "omp.chat",
          "name": "Chat",
          "icon": "media/omp.svg",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "OMP",
      "properties": {
        "omp.server.port": {
          "type": "number",
          "default": 30141,
          "description": "Port of the omp-web local service."
        },
        "omp.server.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start omp-web when the extension activates."
        },
        "omp.server.command": {
          "type": "string",
          "default": "npx -y omp-web@latest --no-open",
          "description": "Shell command used to launch omp-web. Uses the Node.js on PATH (must be >= 22.19)."
        },
        "omp.server.stopOnExit": {
          "type": "boolean",
          "default": true,
          "description": "Stop the omp-web process started by this extension when VS Code exits."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@lobehub/icons": "^5.15.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.30.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0"
  }
}