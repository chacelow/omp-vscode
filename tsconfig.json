{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noUnusedLocals": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/ui/omp/*"],
      "next/navigation": ["src/ui/shims/next-navigation.ts"],
      "os": ["src/ui/shims/os.ts"],
      "path": ["src/ui/shims/path.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
